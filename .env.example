# Public site URL (no trailing slash). Used for canonical URLs and Open Graph links.
# VITE_SITE_URL=https://www.citywidecustodial.com

# Contact form (Web3Forms). Access key is public (same as form id in the dashboard).
# VITE_WEB3FORMS_ACCESS_KEY=your-access-key-uuid

# Optional: Pro plan — CC additional inboxes (semicolon-separated). Omit on free tier.
# VITE_WEB3FORMS_CC_EMAIL=partner@example.com;accounts@example.com
